{
  "name": "@romanager/api",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./main.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --env-file-if-exists=../../.env main.ts",
    "start": "tsx --env-file-if-exists=.env --env-file-if-exists=../../.env main.ts",
    "db:generate": "drizzle-kit generate",
    "db:generate:pg": "DIALECT=postgresql drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@jsr/smallweb__webdav": "^0.0.1",
    "@libsql/client": "^0.14.0",
    "@repo/shared": "workspace:*",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "drizzle-zod": "^0.5.1",
    "hono": "^4.6.14",
    "postgres": "^3.4.9",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
