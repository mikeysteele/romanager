{
  "name": "@repo/cli",
  "version": "1.0.0",
  "exports": "./src/main.ts",
  "bin": {
    "romanager-sync": "./src/main.ts"
  },
  "tasks": {
    "compile:x86_64": "deno compile --allow-read --allow-write --allow-net --allow-env --allow-sys --target x86_64-unknown-linux-gnu --output dist/romanager-sync-x86_64 src/main.ts",
    "compile:aarch64": "deno compile --allow-read --allow-write --allow-net --allow-env --allow-sys --target aarch64-unknown-linux-gnu --output dist/romanager-sync-aarch64 src/main.ts"
  }
}
