{
  "name": "@romanager/ui",
  "version": "0.1.0",
  "exports": {
    ".": "./src/index.html"
  },
  "tasks": {
    "build": "deno run -A --node-modules-dir npm:vite build",
    "dev": "deno run -A npm:vite",
    "preview": "deno run -A npm:vite preview"
  },
  "imports": {
    "esbuild": "npm:esbuild@^0.27.3",
    "lit": "npm:lit@^3.1.0",
    "@lit/task": "npm:@lit/task@^1.0.0",
    "@lit-labs/router": "npm:@lit-labs/router@^0.1.3",
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^1.0.0",
    "@repo/shared": "file:../../packages/shared/mod.ts",
    "@repo/ui-components": "file:../../packages/ui-components/mod.ts",
    "typescript": "npm:typescript@^5.9.3",
    "vite": "npm:rolldown-vite@latest"
  },
  "compilerOptions": {
    "experimentalDecorators": true,
    "lib": ["dom", "es2017", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "@repo/shared": ["../../packages/shared/mod.ts"],
      "@repo/ui-components": ["../../packages/ui-components/mod.ts"]
    }
  }
}
