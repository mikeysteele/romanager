{
  "name": "romanager",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "description": "Self-hosted retro ROM manager and companion sync daemon",
  "scripts": {
    "dev": "pnpm --parallel --filter @romanager/ui --filter @romanager/api dev",
    "dev:api": "pnpm --filter @romanager/api dev",
    "dev:ui": "pnpm --filter @romanager/ui dev",
    "start": "pnpm --filter @romanager/api start",
    "build": "pnpm --recursive run build",
    "build:api": "pnpm --filter @romanager/api build",
    "build:ui": "pnpm --filter @romanager/ui build",
    "build:cli": "pnpm --filter @repo/cli build:sea",
    "test": "vitest run",
    "test:api": "vitest run tests/api",
    "test:unit": "vitest run tests/unit",
    "test:migrations": "node --import tsx scripts/verify-migrations.ts",
    "test:e2e": "bddgen && playwright test",
    "lint": "oxlint --type-aware",
    "typecheck": "tsc --noEmit",
    "db:generate": "pnpm --filter @romanager/api exec drizzle-kit generate --config=drizzle.config.ts",
    "db:generate:pg": "pnpm --filter @romanager/api run db:generate:pg",
    "db:migrate": "pnpm --filter @romanager/api exec drizzle-kit migrate --config=drizzle.config.ts",
    "db:push": "pnpm --filter @romanager/api exec drizzle-kit push --config=drizzle.config.ts",
    "docker:build": "podman --storage-opt overlay.mount_program=/usr/bin/fuse-overlayfs build --network=host --format docker -t registry.lan.michaelwestcott.me/romanager:latest .",
    "docker:push": "podman push registry.lan.michaelwestcott.me/romanager:latest"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^19.6.0",
    "@libsql/client": "^0.18.0",
    "@playwright/test": "^1.64.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "drizzle-orm": "^0.45.4",
    "jsdom": "^25.0.1",
    "lefthook": "^1.10.8",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "playwright-bdd": "^9.2.1",
    "postject": "1.0.0-alpha.6",
    "rolldown": "^1.2.15",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "zod": "^3.25.76"
  }
}
